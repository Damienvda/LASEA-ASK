# Copy to .env (same folder) and fill in. .env is ignored by git: never commit it.

# The name users type in the browser, the one the Let's Encrypt certificate was issued for.
LASEASK_HOSTNAME=laseask.example.com

# Claude API key (https://console.anthropic.com/). Used by Open WebUI for the models.
ANTHROPIC_API_KEY=REPLACE-ME

# Signs Open WebUI's login sessions. Generate: openssl rand -hex 32. Changing it logs everyone out.
WEBUI_SECRET_KEY=REPLACE-ME

# Open WebUI image tag. "main" follows every release; pin a tested version (v0.x.y from
# https://github.com/open-webui/open-webui/releases) so an update never happens by surprise.
# MCP tools need v0.6.31 or later.
OPENWEBUI_VERSION=main

# Model id for Open WebUI's background tasks (titles, tags...): a cheap one.
TASK_MODEL=claude-haiku-4-5-20251001

# Not read by docker compose: the [tool_server] api_key from backend/config.toml, which you type
# into Open WebUI's MCP connection (README step 8). Kept here only as a reminder of where it goes.
# LASEASK_TOOLS_KEY=
